# Windows local development (Node.js 24).
# Initialize: node --env-file=.env .\nodebb setup --dev
# Run:        node --env-file=.env .\nodebb dev
# Environment variables override config.json. Existing shell variables override this file.
NODE_ENV=development
url=http://localhost:9203
port=9203
bind_address=127.0.0.1

# 本地 WMV 播放、视频封面需要 FFmpeg；已加入 PATH 时可省略。
# Docker 镜像自带 FFmpeg，不要把 Windows 路径传入生产容器。
# FFMPEG_PATH=D:/software/ffmpeg/bin/ffmpeg.exe
# Office（Word/Excel/PPT）转 PDF，PDF 第一页转封面；省略时从 PATH 查找。
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
# PDFTOPPM_PATH=D:/software/poppler/Library/bin/pdftoppm.exe
database=postgres

# Existing PostgreSQL service; create a separate database owned by this user first.
postgres__host=127.0.0.1
postgres__port=5432
postgres__database=nodebb
postgres__username=nodebb
postgres__password="CHANGE_ME"
postgres__ssl=false

# 私有附件存储；本地使用已存在的 MinIO 服务，生产连接信息填写在 Compose 中。
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY="CHANGE_ME"
MINIO_BUCKET=nodebb
MINIO_REGION=
MINIO_REQUEST_TIMEOUT_MS=300000

# Initial setup generates a session secret and saves it in config.json.
# Keep config.json persistent; do not commit it or bake it into an image.
# Admin credentials are entered interactively during setup.
# Optional: uncomment and replace to manage the session secret via the environment.
# secret="REPLACE_WITH_A_RANDOM_SESSION_SECRET"
# For Docker deployment, bind_address must be 0.0.0.0 and the DB host must be reachable from the container.

# Enterprise login: enable only after the platform approves this exact callback.
# Automatic redirect requires BOTH flags below to be true and the Uniportal plugin active.
UNIPORTAL_ENABLED=false
UNIPORTAL_AUTO_LOGIN=false
# Require authentication for forum content; keep local admin login accessible.
UNIPORTAL_REQUIRE_LOGIN=true
# Absolute enterprise session lifetime; shorter token expires_in takes precedence.
UNIPORTAL_SESSION_TTL_SECONDS=1800
UNIPORTAL_AUTHORIZE_URL=
UNIPORTAL_TOKEN_URL=
UNIPORTAL_USERINFO_URL=
UNIPORTAL_CLIENT_ID=
UNIPORTAL_AUTH_CLIENT_ID=
UNIPORTAL_CLIENT_SECRET=
UNIPORTAL_SCOPE=
UNIPORTAL_REDIRECT_URI=http://localhost:9203/auth/uniportal/callback
