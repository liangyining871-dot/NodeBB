# Windows local development (Node.js 24).
# Initialize: node --env-file=.env .\nodebb setup --dev
# Run:        node --env-file=.env .\nodebb dev
# Environment variables override config.json. Existing shell variables override this file.
NODE_ENV=development
url=http://localhost:9203
port=9203
bind_address=127.0.0.1
database=postgres

# Existing PostgreSQL service; create a separate database owned by this user first.
postgres__host=127.0.0.1
postgres__port=5432
postgres__database=nodebb
postgres__username=nodebb
postgres__password="CHANGE_ME"
postgres__ssl=false

# Initial setup generates a session secret and saves it in config.json.
# Keep config.json persistent; do not commit it or bake it into an image.
# Admin credentials are entered interactively during setup.
# Optional: uncomment and replace to manage the session secret via the environment.
# secret="REPLACE_WITH_A_RANDOM_SESSION_SECRET"
# For Docker deployment, bind_address must be 0.0.0.0 and the DB host must be reachable from the container.
