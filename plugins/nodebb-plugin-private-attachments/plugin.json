{
  "id": "nodebb-plugin-private-attachments",
  "name": "论坛私有附件",
  "scripts": ["static/video.js", "static/documents.js", "static/external-topics.js", "static/direct-upload-client.js"],
  "modules": { "private-attachments/direct-upload.js": "static/direct-upload.js" },
  "scss": ["static/video.scss"],
  "hooks": [
    { "hook": "filter:config.get", "method": "directUploadConfig" },
    { "hook": "filter:topic.post", "method": "validateExternalTopic" },
    { "hook": "filter:topic.create", "method": "saveExternalTopic" },
    { "hook": "filter:topic.edit", "method": "saveExternalTopic" },
    { "hook": "filter:post.edit", "method": "validateExternalEdit", "priority": 1 },
    { "hook": "filter:composer.push", "method": "externalComposer" },
    { "hook": "filter:topics.get", "method": "externalTopicCards", "priority": 20 },
    { "hook": "filter:teasers.get", "method": "previewSummaries" },
    { "hook": "filter:topics.get", "method": "previewTopics" },
    { "hook": "static:app.load", "method": "init", "priority": 1 },
    { "hook": "filter:files.storage", "method": "resourceStorage" },
    { "hook": "static:user.delete", "method": "deleteUserResources" },
    { "hook": "filter:groups.destroy", "method": "deleteGroupResources" },
    { "hook": "filter:group.renamed", "method": "renameGroupResources" },
    { "hook": "filter:category.purge", "method": "deleteCategoryResources" },
    { "hook": "filter:uploadPostFile", "method": "uploadPostFile" },
    { "hook": "filter:post.create", "method": "preparePost" },
    { "hook": "filter:post.edit", "method": "preparePost" },
    { "hook": "filter:posts.purge", "method": "purge" },
    { "hook": "filter:topic.thumb.associate", "method": "associateThumb" },
    { "hook": "filter:topics.hasThumbs", "method": "hasThumbs" },
    { "hook": "filter:topics.getThumbs", "method": "getThumbs" }
  ]
}
