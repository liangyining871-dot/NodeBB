{
  "id": "nodebb-plugin-private-attachments",
  "name": "论坛私有附件",
  "hooks": [
    {
      "hook": "static:app.load",
      "method": "init"
    },
    {
      "hook": "filter:uploadPostFile",
      "method": "uploadPostFile"
    },
    {
      "hook": "filter:post.create",
      "method": "preparePost"
    },
    {
      "hook": "filter:post.edit",
      "method": "preparePost"
    },
    {
      "hook": "filter:posts.purge",
      "method": "purge"
    },
    {
      "hook": "filter:topic.thumb.associate",
      "method": "associateThumb"
    },
    {
      "hook": "filter:topics.hasThumbs",
      "method": "hasThumbs"
    },
    {
      "hook": "filter:topics.getThumbs",
      "method": "getThumbs"
    }
  ]
}
